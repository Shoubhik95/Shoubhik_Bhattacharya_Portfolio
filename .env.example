PORT=3000
JWT_SECRET=change-this-to-a-long-random-string

# Owner Gmail (matches contact section on portfolio)
OWNER_EMAIL=shoubhikbhattacharya06@gmail.com
GMAIL_USER=shoubhikbhattacharya06@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password-here

# Default dashboard passcode on first run
DEFAULT_PASSCODE=owner123

# --- LIVE DEPLOY (Render backend) ---
# MongoDB Atlas free cluster — REQUIRED for live hire data to persist
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/shoubhik_portfolio

# Comma-separated Netlify + localhost URLs (no trailing slash)
ALLOWED_ORIGINS=http://localhost:3000,https://your-site.netlify.app

# Set false on Render when frontend is on Netlify
SERVE_STATIC=true

# --- NETLIFY ONLY (set in Netlify dashboard, not .env) ---
# PORTFOLIO_API_URL=https://your-app.onrender.com
